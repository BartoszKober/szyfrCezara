<Window x:Class="szyfr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="szyfr" Height="200" Width="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tekst:" Margin="0,0,10,0"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="InputTextBox"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Przesunięcie:" Margin="0,10,10,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="ShiftTextBox" Margin="0,10,0,0"/>

        <Button Grid.Row="2" Grid.Column="1" Name="EncryptButton" Content="Szyfruj" Margin="0,10,0,0" Width="80" Click="EncryptButton_Click"/>
        <Button Grid.Row="2" Grid.Column="0" Name="SaveButton" Content="Zapisz do pliku" Margin="0,10,0,0" Width="80" Click="SaveButton_Click"/>
        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Name="OutputTextBlock" Margin="0,10,0,0"/>
    </Grid>
</Window>
